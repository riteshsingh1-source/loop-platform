{
  "name": "loop-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:player": "node apps/player-demo/server.mjs",
    "dev:connected": "node --env-file-if-exists=.env.local apps/player-demo/server.mjs",
    "dev:web": "node --env-file-if-exists=.env.local ./node_modules/next/dist/bin/next dev apps/web",
    "build:web": "npm run build --workspace @loop/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-ivs": "^3.1176.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/client-secrets-manager": "^3.1176.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@smithy/node-http-handler": "4.14.2",
    "hls.js": "1.7.4",
    "s3rver": "3.7.1"
  }
}
