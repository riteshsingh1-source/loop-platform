AWS_REGION=ap-south-1
# Optional: use a local AWS profile with Secrets Manager read access.
# AWS_PROFILE=your-profile
# On a Zscaler-inspected network, set the absolute path to its trusted root CA:
# LOOP_AWS_CA_CERT_PATH=/absolute/path/to/zscaler-root.pem
LOOP_IVS_SECRET_ID=loop-demo/ivs-stream-config
LOOP_ADMIN_TOKEN=replace-with-a-long-random-private-value

# Vercel Next.js control API. Keep these values in Vercel's server environment.
# Vercel uses short-lived OIDC credentials through AWS_ROLE_ARN; never add AWS keys here.
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/loop-vercel-control
ECS_CLUSTER_ARN=arn:aws:ecs:ap-south-1:970974808424:cluster/loop-broadcast
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:ap-south-1:970974808424:task-definition/loop-ivs-broadcaster:2
ECS_TASK_FAMILY=loop-ivs-broadcaster
ECS_SUBNET_IDS=subnet-0f856b9400936b03c,subnet-0df5d6d2759fa0908,subnet-0778317b9eea727c7
ECS_SECURITY_GROUP_ID=sg-0dd34b18269231635
LOOP_IVS_CHANNEL_ARN=arn:aws:ivs:ap-south-1:970974808424:channel/wsQirbowY6nq
LOOP_VOD_PLAYBACK_URL=https://d22zjoamwa62fa.cloudfront.net/media/loop-live-source.mp4
LOOP_IVS_PLAYBACK_URL=https://8e37a21bdd5c.ap-south-1.playback.live-video.net/api/video/v1/ap-south-1.970974808424.channel.wsQirbowY6nq.m3u8
